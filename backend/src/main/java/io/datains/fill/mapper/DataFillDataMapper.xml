<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.datains.fill.mapper.DataFillDataMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO data_fill_data
        (id,
         form_id,
         form_data,
         creator,
         version)
        values (#{id},
                #{formId},
                #{formData},
                #{creator},
                #{version})
    </insert>
    <select id="getByFormId" resultType="io.datains.fill.entry.DataFillData">
        SELECT id,
               form_id,
               version,
               creator,
               create_time
        FROM data_fill_data
        WHERE form_id = #{formId}
        order by version desc
    </select>
    <select id="getById" resultType="io.datains.fill.entry.DataFillData">
        select *
        from data_fill_data
        where id = #{id}
    </select>
    <update id="deleteByFormIds">
        delete from data_fill_data
        WHERE form_id IN
        <foreach collection="formIds" item="formId" open="(" separator="," close=")">
            #{formId}
        </foreach>
    </update>
    <update id="update">
        UPDATE data_fill_data
        <set>
            <if test="formId != null">
                form_id = #{formId},
            </if>
            <if test="formData != null">
                form_data = #{formData},
            </if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
